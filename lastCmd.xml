        </Parm>
        <Parm Kwd="B" PosNbr="3" KeyParm="NO" RtnVal="NO" PassVal="DFT" Type="DEC" Min="0" Max="1" Prompt="Decimal value" Len="7.0" Rstd="NO" AlwUnprt="YES" AlwVar="YES" Expr="NO" Full="NO" DspInput="YES" Vary="NO" PassAtr="NO" Case="MONO" CCSID="JOB" IsDtaAra="NO" IsFile="NO" IsPgm="NO" Choice="Number"></Parm>
