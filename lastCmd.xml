        <Parm Kwd="AMT" PosNbr="5" KeyParm="NO" RtnVal="NO" PassVal="DFT" Type="DEC" Min="0" Max="1" Prompt="Amt &gt; 50" Len="7.0" Rstd="NO" Rel="GT" RelVal="50" AlwUnprt="YES" AlwVar="YES" Expr="NO" Full="NO" DspInput="YES" Vary="NO" PassAtr="NO" Case="MONO" CCSID="JOB" IsDtaAra="NO" IsFile="NO" IsPgm="NO" Choice="Number"></Parm>
        <Dep CtlKwdRel="ALWAYS" NbrTrueRel="EQ" NbrTrue="1" MsgID="CPD0141">
