<QcdCLCmd DTDVersion="2.0">
    <Cmd CmdName="BADQUAL" CmdLib="COZTEST" CCSID="37" MaxPos="99" Prompt="Test spcval for QUAL parms" MsgF="QCPFMSG" MsgFLib="__LIBL" ExecBatch="YES" ChgCmdExit="NO" RtvCmdExit="NO">
        <Parm Kwd="PRODUCT" PosNbr="1" KeyParm="NO" RtnVal="NO" PassVal="DFT" Type="CHAR" Min="0" Max="1" Prompt="7-char product ID" Len="7" Rstd="NO" AlwUnprt="YES" AlwVar="YES" Expr="YES" Full="NO" DspInput="YES" Vary="NO" PassAtr="NO" Case="MONO" CCSID="JOB" InlPmtLen="7" IsDtaAra="NO" IsFile="NO" IsPgm="NO" Choice="Character value"></Parm>
        <Parm Kwd="HAPPY" PosNbr="2" KeyParm="NO" RtnVal="NO" PassVal="DFT" Type="LGL" Min="0" Max="1" Len="1" Rstd="YES" AlwUnprt="YES" AlwVar="YES" Expr="NO" Full="NO" DspInput="YES" Vary="NO" PassAtr="NO" Case="MONO" CCSID="JOB" IsDtaAra="NO" IsFile="NO" IsPgm="NO" Choice="*YES, *NO">
            <SpcVal>
