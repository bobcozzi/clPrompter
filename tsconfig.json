// File: tsconfig.json
{
  "compilerOptions": {
    "module": "node16", // Node.js modules for extension
    "target": "es2020",
    "lib": [
      "es2020",
      "dom"
    ],
    "outDir": "out", // Output to out/ for extension
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node16", // Node.js resolution
    "types": [
      "node",
      "vscode"
    ],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    ".vscode-test",
    "out",
    "backup",
    "src/prompter.ts", // Exclude webview files
    "src/webview-assets/**/*", // Exclude webview assets (compiled by tsconfig.webview.json)
    "src/test/**/*" // Exclude entire test folder from builds
  ]
}